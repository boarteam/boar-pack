{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "esnext",
    "baseUrl": "./",
    "outDir": "./dist",
    "lib": ["esnext", "dom"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "importHelpers": true,
    "moduleResolution": "node",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "allowJs": true,
    "experimentalDecorators": true
  },
  "include": ["src"]
}
