{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2017",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "removeComments": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "resolveJsonModule": true,
    "preserveSymlinks": true,
    "paths": {}
  },
  "include": [
    "src",
    "node_modules/@boarteam/boar-pack-users-backend/src",
    "node_modules/@boarteam/boar-pack-users-backend/package.json",
    "node_modules/@boarteam/boar-pack-common-backend/src",
    "node_modules/@boarteam/boar-pack-common-backend/package.json"
  ],
  "exclude": ["test", "**/dist*", "**/*spec.ts", ".yalc/**/*"]
}
